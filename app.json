{
  "expo": {
    "name": "DoeMais Mobile",
    "slug": "doemais-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F8FAFC"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "br.org.doemais.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#10B981"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "46746903-d8b6-4b35-bbd6-67999a99c477"
      }
    },
    "owner": "notriom"
  }
}
